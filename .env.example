# --- App ---
ENVIRONMENT=development
APP_NAME="R&B Asset Inventory"
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-dev-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Database (locally installed PostgreSQL, no PostGIS or Docker) ---
DATABASE_URL=postgresql+psycopg://rb_admin:rudra123@localhost:5432/rb_assets

# --- Local file storage ---
# Files are written under backend/uploads/ by default; override if needed.
# UPLOAD_DIR=C:/path/to/backend/uploads

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_URL=https://demotiles.maplibre.org/style.json
